{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      ["internal", "parent", "type"],
      ["sibling", "index"]
    ],
    "newlinesBetween": true
  },
  "sortPackageJson": false,
  "ignorePatterns": [".github", "pnpm-lock.yaml", "CHANGELOG.md"]
}
