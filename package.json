{
  "name": "@lifi/tenderlysim",
  "version": "0.0.68",
  "description": "Helpers to simulate lifi quotes",
  "author": {
    "name": "LI.FI",
    "url": "https://li.fi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/tenderly-sim"
  },
  "module": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": "./build/src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json && pnpm resolve-tspaths",
    "demo": "node -r ts-node/register src/demo.ts",
    "clean": "rm -rf ./build",
    "test": "jest",
    "test:unit": "pnpm test .unit.spec.ts",
    "test:int": "pnpm test .int.spec.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "check:types": "tsc --noEmit --esModuleInterop",
    "check:circular-deps": "madge --circular $(find ./src -name '*.ts')",
    "release": "standard-version -a",
    "release:beta": "standard-version -a --prerelease beta --skip.changelog",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@lifi/types": "19.0.0",
    "@types/memoizee": "^0.4.12",
    "axios": "^1.20.0",
    "ethers": "^6.17.0",
    "memoizee": "^0.4.17",
    "pino": "^10.3.1",
    "resolve-tspaths": "^0.8.23",
    "tsconfig-paths": "^4.2.0"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10 <14.0.2": "^14.0.2",
      "minimatch@>=9 <11.0.1": "^11.0.1"
    }
  }
}
